# 複製本檔為 .env 後填入各環境的值。.env 已在 .gitignore，不會進版本庫。

# MySQL 連線（api/src/db.php）
# XAMPP 出廠設定是 root、空密碼；正式環境請建專用帳號
DB_HOST=127.0.0.1
DB_NAME=idealightsdg
DB_USER=root
DB_PASS=

# 蛋糕實驗的 LLM：訊問的 AI 角色 + AI 回饋（api/src/config.php 的 ck_llm_*）
# 預設用 Google AI Studio 的 Gemma 4。金鑰到 https://aistudio.google.com/apikey 申請。
LLM_API_KEY=AIza...
# 以下三項選填，不填就用預設值
# LLM_MODEL=gemma-4-26b-a4b-it        # 實測首字約 1 秒。gemma-4-31b-it 要 18 秒，訊問階段不能用
# LLM_REASONING_EFFORT=minimal        # Gemma 4 必須是 minimal，否則思考過程會混進回答且慢十倍；
#                                     # 換成不支援此參數的供應商時填 omit
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   換供應商只要改這裡（任何 OpenAI 相容端點皆可），程式不用動

# SDG 實驗的 chat.php／evaluate.php 專用，固定打 api.openai.com。
# 不要把別家的金鑰填在這裡——會被送到 OpenAI 的伺服器。
OPENAI_API_KEY=sk-...

# SurveyCake 前測／後測問卷的公開作答網址（api/public/ck_survey.php）
SURVEYCAKE_PRE_URL=https://www.surveycake.com/s/xxxx
SURVEYCAKE_POST_URL=https://www.surveycake.com/s/yyyy
